BOT_TOKEN=

WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Путь к бинарнику tesseract, если он не в PATH (актуально для Windows,
# например C:\Program Files\Tesseract-OCR\tesseract.exe). На Linux — пусто.
TESSERACT_CMD=
OCR_LANGS=rus+eng
OCR_MIN_CHARS=15

# Бесплатный ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

DATA_DIR=./data
